# --- OpenRouter (choose a model available to your OpenRouter account)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Draftroom
OPENROUTER_APP_VISIBILITY=hidden

# --- Web research (Tavily preferred; falls back to DuckDuckGo with no key)
TAVILY_API_KEY=
ENABLE_WEB=true

# --- Enterprise RAG (Pinecone; falls back to a local vector store with no key)
PINECONE_API_KEY=
PINECONE_INDEX=docgen-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional hosted embeddings (dimension 1024). Leave empty to use the built-in local embedder (dim 512)
PINECONE_EMBED_MODEL=

# --- API security (if set, clients must send header X-API-Key)
API_KEY=
APP_ENV=development
DATA_DIR=data
# Leave unset for local SQLite. Production must use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/draftroom
MAX_UPLOAD_MB=25
MAX_UPLOAD_TOTAL_MB=100
MAX_UPLOAD_FILES=10
